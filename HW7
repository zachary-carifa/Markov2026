# Total variation distance as delta t decreases
a <- 10:2000
dt <- 1/a
tv <- sapply(a, function(m) {
  k <- 0:m
  0.5*(sum(abs(dbinom(k,m,4/m)-dpois(k,4))) +
       ppois(m,4,lower.tail=FALSE))
})
fit <- lm(log(tv) ~ log(dt))
cat("Log-log total variation slope:", coef(fit)[2], "\n")
plot(dt, tv, log="xy", xlab="Delta t", ylab="Total variation distance",
     main="Binomial versus Poisson")
lines(dt, exp(coef(fit)[1])*dt^coef(fit)[2], col="red", lwd=2)
dev.off()
