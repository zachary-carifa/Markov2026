# Follow all subsets of students still working
finish_group <- function(lam) {
  n <- length(lam)
  E <- numeric(2^n)
  last <- matrix(0, 2^n, n)
  bits <- bitwShiftL(1L, 0:(n-1))
  for (mask in 1:(2^n-1)) {
    students <- which(bitwAnd(mask, bits) != 0)
    total <- sum(lam[students])
    E[mask+1] <- 1/total
    if (length(students)==1) last[mask+1,students] <- 1
    for (i in students) {
      smaller <- mask-bits[i]
      E[mask+1] <- E[mask+1]+lam[i]/total*E[smaller+1]
      if (length(students)>1)
        last[mask+1,] <- last[mask+1,]+lam[i]/total*last[smaller+1,]
    }
  }
  list(mean=E[2^n], last=last[2^n,])
}

# Alternating sum over nonempty groups
alternate <- function(lam) {
  n <- length(lam)
  bits <- bitwShiftL(1L, 0:(n-1))
  total <- 0
  for (mask in 1:(2^n-1)) {
    students <- which(bitwAnd(mask, bits) != 0)
    total <- total+(-1)^(length(students)+1)/sum(lam[students])
  }
  total
}

