x <- c(-1.77, 2.47, 1.34, 2.18, 13.05, 1.60, 1.50, -1.97,
       0.79, 1.50, 2.00, 2.63, 1.19, -2.31, 0.87)

logpost <- function(a, b) {
  length(x)*b - sum(log(exp(2*b) + (x-a)^2))
}

iat <- function(v) {
  a <- as.numeric(acf(v, plot=FALSE, lag.max=5000)$acf)[-1]
  pairs <- a[seq(1, length(a)-1, by=2)] + a[seq(2, length(a), by=2)]
  stopat <- which(pairs <= 0)
  if (length(stopat) > 0) pairs <- head(pairs, stopat[1]-1)
  1 + 2*sum(pairs)
}

stepsizes <- c(0.02, 0.5, 5)
chains <- vector("list", 3)
accept <- numeric(3)
tau <- numeric(3)

for (j in 1:3) {
  z <- c(0, 0)
  chain <- matrix(0, 50000, 2)
  count <- 0
  for (t in 1:50000) {
    y <- z + rnorm(2, sd=stepsizes[j])
    if (log(runif(1)) < logpost(y[1], y[2]) - logpost(z[1], z[2])) {
      z <- y
      count <- count + 1
    }
    chain[t, ] <- z
  }
  chains[[j]] <- chain
  accept[j] <- count/50000
  tau[j] <- iat(chain[,1])
}
print(data.frame(step=stepsizes, acceptance=accept, IAT_alpha=tau))

