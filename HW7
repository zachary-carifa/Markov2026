# 3d: Meteor shower simulations
hours <- 200000
rate <- 4

# Method 1: exponential gaps
clock <- numeric(hours)
Ng <- integer(hours)
H1g <- integer(hours)
raster_g <- replicate(10, numeric(0), simplify=FALSE)
step <- 0
repeat {
  step <- step+1
  clock <- clock+rexp(hours, rate)
  if (step==1) T1g <- clock
  if (step==3) T3g <- clock
  inside <- clock<=1
  Ng <- Ng+as.integer(inside)
  H1g <- H1g+as.integer(inside & clock<=0.5)
  for (i in 1:10) if (inside[i]) raster_g[[i]] <- c(raster_g[[i]], clock[i])
  if (step>=3 && !any(inside)) break
}

