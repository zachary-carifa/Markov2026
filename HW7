# Exact density of the last finishing time
pdfM <- function(times) {
  sapply(times, function(t) {
    sum(sapply(1:6, function(i) {
      rates[i]*exp(-rates[i]*t)*prod(1-exp(-rates[-i]*t))
    }))
  })
}

