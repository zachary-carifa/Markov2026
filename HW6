# 3c
h1 <- function(N, R0) {
  K <- N/10
  rho <- 1
  total <- 1
  for (k in 1:(K-1)) {
    rho <- rho*N/(R0*(N-k))
    total <- total+rho
  }
  1/total
}

r0 <- seq(0.5, 3, length.out=300)
h100 <- sapply(r0, function(x) h1(100,x))
h1000 <- sapply(r0, function(x) h1(1000,x))

plot(r0, h100, type="l", lwd=2, ylim=c(-1,1),
     xlab="R0", ylab="h1", main="Outbreak probability")
lines(r0, h1000, lwd=2, lty=2)
lines(r0, 1-1/r0, lwd=2, lty=3)
legend("bottomright", c("N=100", "N=1000", "1 - 1/R0"),
       lty=1:3, lwd=2)
dev.off()


# 3d
N <- 100
K <- 10
dt <- 0.005
r0s <- c(0.5, 0.8, 1.5, 3)
times <- numeric(length(r0s))

for (v in 1:length(r0s)) {
  n <- 1:(K-1)
  p <- r0s[v]*n*(N-n)/N*dt
  q <- n*dt

  A <- diag(p+q)
  for (i in 1:(K-1)) {
    if (i>1) A[i,i-1] <- -q[i]
    if (i<K-1) A[i,i+1] <- -p[i]
  }

  e <- solve(A, rep(1,K-1))
  times[v] <- e[1]*dt
}
print(data.frame(R0=r0s, e1_dt=times))

# Simulation check for R0=0.8
set.seed(3570)
R <- 10000
x <- rep(1, R)
steps <- numeric(R)
R0 <- 0.8

while (any(x>0 & x<K)) {
  active <- which(x>0 & x<K)
  n <- x[active]
  p <- R0*n*(N-n)/N*dt
  q <- n*dt
  u <- runif(length(active))

  x[active] <- n + (u<p) - (u>=p & u<p+q)
  steps[active] <- steps[active]+1
}

cat("Simulated e1*dt:", mean(steps)*dt, "\n")
cat("Exact e1*dt:", times[2], "\n")
