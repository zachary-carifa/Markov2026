makeP <- function(a, b) {
  P <- matrix(0, 5, 5)

  for (k in 0:4) {
    if (k < 4) P[k+1, k+2] <- a*(4-k)/4
    if (k > 0) P[k+1, k] <- b*k/4
    P[k+1, k+1] <- 1 - sum(P[k+1, ])
  }

  P
}
