# Problem 3c

set.seed(3570)

R <- 100
T <- 100000

# Start all surfers at page 1
x <- rep(1, R)
counts <- matrix(0, R, 8)

# Cumulative probabilities
cdf <- t(apply(G, 1, cumsum))

times <- unique(round(10^seq(2, 5, length.out=35)))
errors <- numeric(length(times))
j <- 1

# Simulate surfers
for (t in 1:T) {

  u <- runif(R)

  # Discrete inverse transform
  x <- 1 + rowSums(u > cdf[x, , drop=FALSE])

  # Count visits

idx <- cbind(1:R, x)
  counts[idx] <- counts[idx] + 1

  if (j <= length(times) && t == times[j]) {

    estimates <- counts/t
    diff <- abs(sweep(estimates, 2, pi))

    errors[j] <- sqrt(mean(apply(diff, 1, max)^2))
    j <- j + 1
  }
}

# Plot 1: simulated vs exact PageRank
barplot(
  rbind(counts[1,]/T, pi),
  beside=TRUE,
  names.arg=1:8,
  col=c("gray60", "steelblue"),
  legend.text=c("Surfer", "Exact"),
  xlab="Page",
  ylab="Probability",
  main="Simulated vs Exact PageRank"
)

# Plot 2: error over time
fit <- lm(log(errors) ~ log(times))
slope <- coef(fit)[2]

plot(times, errors, log="xy",
     xlab="T",
     ylab="RMS maximum error",
     main="Simulation Error")

lines(times,
      exp(coef(fit)[1])*times^slope,
      col="red", lwd=2)

# Fitted slope
print(slope)

# Final error comparison
print(tail(errors, 1))
